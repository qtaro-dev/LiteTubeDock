<Window x:Class="LiteTubeDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LiteTubeDock"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="LiteTube Dock"
        Icon="pack://application:,,,/Resource/Images/LiteTubeDock.ico"
        Height="800"
        Width="600">
    <Window.Resources>
        <Style x:Key="NavigationToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFF1E8" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF8A3D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFD8C2" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF5A1F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                                <Setter TargetName="ButtonBorder" Property="Background" Value="Transparent" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationToolbarImageStyle" TargetType="Image">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>
    </Window.Resources>
    
    <!-- ルートグリッド -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="ToolbarRow" Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="FavoriteButtonRow" Height="64" />
            <RowDefinition x:Name="StatusBarRow" Height="Auto" />
        </Grid.RowDefinitions>

        <!-- メニュー -->
        <Menu x:Name="TopMenu" Grid.Row="0">
                <MenuItem x:Name="FileMenuItem" Header="ファイル">
                <MenuItem x:Name="ImportBookmarksMenuItem" Header="お気に入り設定をインポート" />
                <MenuItem x:Name="ExportBookmarksMenuItem" Header="お気に入り設定をエクスポート" />
                <Separator />
                <MenuItem x:Name="ExitMenuItem" Header="終了" />
            </MenuItem>

            <MenuItem x:Name="ViewMenuItem" Header="表示">
                <MenuItem x:Name="AlwaysOnTopMenuItem" Header="常に最前面" />
                <MenuItem x:Name="ShowAddressBarMenuItem" Header="アドレスバーを表示" />
                <MenuItem x:Name="ShowNavigationButtonsMenuItem" Header="ナビゲーションボタンを表示" />
                <MenuItem x:Name="WindowSizeMenuItem" Header="ウィンドウサイズ">
                    <MenuItem x:Name="WindowSize800x600MenuItem" Header="800x600" />
                    <MenuItem x:Name="WindowSize960x540MenuItem" Header="960x540" />
                    <MenuItem x:Name="WindowSize1024x768MenuItem" Header="1024x768" />
                    <MenuItem x:Name="WindowSize1280x720MenuItem" Header="1280x720" />
                    <MenuItem x:Name="WindowSize1600x900MenuItem" Header="1600x900" />
                    <MenuItem x:Name="WindowSize1920x1080MenuItem" Header="1920x1080" />
                    <Separator />
                    <MenuItem x:Name="WindowSize540x960MenuItem" Header="540x960" />
                    <MenuItem x:Name="WindowSize720x1280MenuItem" Header="720x1280" />
                    <MenuItem x:Name="WindowSize768x1024MenuItem" Header="768x1024" />
                    <MenuItem x:Name="WindowSize900x1600MenuItem" Header="900x1600" />
                    <MenuItem x:Name="WindowSize1080x1920MenuItem" Header="1080x1920" />
                    <Separator />
                    <MenuItem x:Name="WindowSizeCustomMenuItem" Header="カスタム" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="BackMenuItem" Header="戻る" />
                <MenuItem x:Name="ForwardMenuItem" Header="進む" />
                <MenuItem x:Name="ReloadMenuItem" Header="再読み込み" />
                <MenuItem x:Name="HomeMenuItem" Header="ホーム" />
                <Separator />
                <MenuItem x:Name="ResetWindowPositionMenuItem" Header="ウィンドウ位置をリセット" />
            </MenuItem>

            <MenuItem x:Name="SettingsMenuItem" Header="設定">
                <MenuItem x:Name="OpenSettingsMenuItem" Header="設定を開く" />
                <MenuItem x:Name="ReloadSettingsMenuItem" Header="設定を再読み込み" />
            </MenuItem>

            <MenuItem x:Name="HelpMenuItem" Header="ヘルプ">
                <MenuItem x:Name="OpenHelpMenuItem" Header="ヘルプを開く" />
                <MenuItem x:Name="PlayerModeDiagnosticsMenuItem" Header="プレイヤーモード診断" />
                <MenuItem x:Name="AboutMenuItem" Header="バージョン情報" />
            </MenuItem>
        </Menu>

        <!-- ナビゲーションボタン / アドレスバー -->
        <DockPanel x:Name="AddressBarPanel"
                   Grid.Row="1"
                   Margin="8,6,8,0"
                   LastChildFill="True">
            <StackPanel x:Name="NavigationButtonPanel"
                        DockPanel.Dock="Left"
                        Orientation="Horizontal">
                <Button x:Name="BackNavigationButton"
                        Style="{StaticResource NavigationToolbarButtonStyle}"
                        ToolTip="戻る"
                        IsEnabled="False">
                    <Image Source="pack://application:,,,/Resource/Left.png"
                           Style="{StaticResource NavigationToolbarImageStyle}" />
                </Button>
                <Button x:Name="ForwardNavigationButton"
                        Style="{StaticResource NavigationToolbarButtonStyle}"
                        ToolTip="進む"
                        IsEnabled="False">
                    <Image Source="pack://application:,,,/Resource/Right.png"
                           Style="{StaticResource NavigationToolbarImageStyle}" />
                </Button>
                <Button x:Name="ReloadNavigationButton"
                        Style="{StaticResource NavigationToolbarButtonStyle}"
                        ToolTip="再読み込み"
                        IsEnabled="False">
                    <Image Source="pack://application:,,,/Resource/RELOAD.png"
                           Style="{StaticResource NavigationToolbarImageStyle}" />
                </Button>
                <Button x:Name="HomeNavigationButton"
                        Style="{StaticResource NavigationToolbarButtonStyle}"
                        ToolTip="ホーム">
                    <Image Source="pack://application:,,,/Resource/HOME.png"
                           Style="{StaticResource NavigationToolbarImageStyle}" />
                </Button>
            </StackPanel>
            <DockPanel x:Name="AddressInputPanel"
                       LastChildFill="True">
                <Button x:Name="CopyCurrentUrlButton"
                        DockPanel.Dock="Right"
                        Content="現在URLをコピー"
                        Width="120"
                        Margin="8,0,0,0" />
                <Button x:Name="NavigateButton"
                        DockPanel.Dock="Right"
                        Content="移動"
                        Width="64"
                        Margin="8,0,0,0" />
                <TextBox x:Name="AddressTextBox"
                         VerticalContentAlignment="Center"
                         MinHeight="28" />
            </DockPanel>
        </DockPanel>

        <!-- WebView2 表示領域 -->
        <Border x:Name="PlayerArea" Grid.Row="2" BorderBrush="Gray" BorderThickness="2" Margin="8">
            <wv2:WebView2 x:Name="PlayerWebView" />
        </Border>


        <!-- ステータスバー -->
        <StatusBar x:Name="StatusBarArea" Grid.Row="4">
            <TextBlock x:Name="CurrentUrlText" Text="現在URL: -" />
            <Separator />
            <TextBlock x:Name="LoadingStatusText" Text="状態: 待機中" />
            <Separator />
            <TextBlock x:Name="AlwaysOnTopStatusText" Text="最前面: OFF" />
        </StatusBar>

        <!-- ここにお気に入りボタン10個 -->
        <UniformGrid x:Name="FavoriteButtonPanel" Grid.Row="3" Columns="10">
            <Button x:Name="FavoriteButton01" Content="Home" Margin="4" />
            <Button x:Name="FavoriteButton02" Content="BGM1" Margin="4" />
            <Button x:Name="FavoriteButton03" Content="BGM2" Margin="4" />
            <Button x:Name="FavoriteButton04" Content="Live" Margin="4" />
            <Button x:Name="FavoriteButton05" Content="作業用" Margin="4" />
            <Button x:Name="FavoriteButton06" Content="URL6" Margin="4" />
            <Button x:Name="FavoriteButton07" Content="URL7" Margin="4" />
            <Button x:Name="FavoriteButton08" Content="URL8" Margin="4" />
            <Button x:Name="FavoriteButton09" Content="URL9" Margin="4" />
            <Button x:Name="FavoriteButton10" Content="URL10" Margin="4" />
        </UniformGrid>
    </Grid>
</Window>
