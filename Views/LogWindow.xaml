<Window x:Class="LiteTubeDock.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ログ"
        Width="980"
        Height="680"
        MinWidth="720"
        MinHeight="480"
        Icon="pack://application:,,,/Resource/Images/LiteTubeDock.ico"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ReloadLogButton" Width="96" Height="30" Margin="8,0,0,0" />
                <Button x:Name="CopyAllLogButton" Width="96" Height="30" Margin="8,0,0,0" />
                <Button x:Name="OpenLogFolderButton" Width="128" Height="30" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="LogFileNameText"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LogMetadataText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <CheckBox x:Name="AutoRefreshCheckBox"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Margin="12,0,0,0" />
            <CheckBox x:Name="ScrollToEndCheckBox"
                      Grid.Column="2"
                      VerticalAlignment="Center"
                      Margin="12,0,0,0" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0,0,0">
                <TextBox x:Name="SearchTextBox"
                         Width="180"
                         Height="26"
                         VerticalContentAlignment="Center" />
                <Button x:Name="FindNextButton"
                        Width="84"
                        Height="26"
                        Margin="6,0,0,0" />
            </StackPanel>
        </Grid>

        <TextBox x:Name="LogContentTextBox"
                 Grid.Row="2"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 FontFamily="Consolas"
                 FontSize="12"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" />

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button x:Name="CloseLogWindowButton"
                    DockPanel.Dock="Right"
                    Width="96"
                    Height="32" />
            <TextBlock x:Name="LogStatusText"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
